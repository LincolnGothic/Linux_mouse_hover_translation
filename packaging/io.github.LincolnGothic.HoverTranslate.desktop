[Desktop Entry]
Type=Application
Name=Hover Translate
Comment=Translate English and Chinese offline with screen-region OCR or X11 hover
Exec=hover-translate
Icon=hover-translate
Terminal=false
Categories=Utility;Office;
Keywords=translation;offline;dictionary;hover;OCR;Chinese;English;
Actions=Capture;Reader;

[Desktop Action Capture]
Name=Translate screen region
Exec=hover-translate --capture

[Desktop Action Reader]
Name=Translate text
Exec=hover-translate --reader
